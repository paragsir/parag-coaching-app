{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student enrolled in Parag Coaching",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the student"
        },
        "photo": {
          "type": "string",
          "maxLength": 2000,
          "description": "Photo URL of the student"
        },
        "class": {
          "type": "string",
          "maxLength": 50,
          "description": "Class or grade of the student (e.g. Class 10th, Class 12th)"
        },
        "batch": {
          "type": "string",
          "maxLength": 100,
          "description": "Batch name student attends"
        },
        "parentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Father or mother name"
        },
        "whatsappNumber": {
          "type": "string",
          "maxLength": 15,
          "description": "10-digit WhatsApp phone number without spaces"
        },
        "rollNo": {
          "type": "string",
          "maxLength": 20,
          "description": "Unique roll number in coaching"
        },
        "monthlyFee": {
          "type": "number",
          "description": "Agreed monthly tuition fee amount in INR"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp ISO string of creation"
        }
      },
      "required": ["name", "class", "batch", "parentName", "whatsappNumber"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Coaching class batch schedule",
      "type": "object",
      "properties": {
        "batchName": {
          "type": "string",
          "maxLength": 100,
          "description": "Batch title e.g. Morning Board Prep"
        },
        "timing": {
          "type": "string",
          "maxLength": 100,
          "description": "Schedule time e.g. 07:00 AM - 08:30 AM"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject taught e.g. Mathematics & Science"
        },
        "classLevel": {
          "type": "string",
          "maxLength": 50,
          "description": "Grade level"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp"
        }
      },
      "required": ["batchName", "timing"]
    },
    "Fee": {
      "title": "Fee",
      "description": "Tuition fee ledger entry for student",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Document ID of student"
        },
        "studentName": {
          "type": "string",
          "maxLength": 100,
          "description": "Cached name of student"
        },
        "month": {
          "type": "string",
          "maxLength": 30,
          "description": "Month name e.g. November 2026"
        },
        "amount": {
          "type": "number",
          "description": "Fee amount in INR"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Due date YYYY-MM-DD"
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "late"],
          "description": "Payment status"
        },
        "daysLate": {
          "type": "number",
          "description": "Calculated days late"
        },
        "paidAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Timestamp when fee was marked paid"
        },
        "paymentMode": {
          "type": "string",
          "maxLength": 50,
          "description": "UPI, Cash, or NetBanking"
        },
        "receiptNumber": {
          "type": "string",
          "maxLength": 50,
          "description": "Generated receipt voucher code"
        }
      },
      "required": ["studentId", "month", "amount", "dueDate", "status"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance mark for student",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Student reference ID"
        },
        "batchName": {
          "type": "string",
          "maxLength": 100,
          "description": "Batch name"
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "description": "Date YYYY-MM-DD"
        },
        "status": {
          "type": "string",
          "enum": ["P", "A"],
          "description": "Present or Absent"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Last recorded timestamp"
        }
      },
      "required": ["studentId", "date", "status"]
    },
    "Test": {
      "title": "Test",
      "description": "Weekly test performance record",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Student document ID"
        },
        "batchName": {
          "type": "string",
          "maxLength": 100,
          "description": "Batch name"
        },
        "testTitle": {
          "type": "string",
          "maxLength": 150,
          "description": "Title e.g. Weekly Physics Chapter 4 Test"
        },
        "subject": {
          "type": "string",
          "maxLength": 100,
          "description": "Subject tested"
        },
        "marks": {
          "type": "number",
          "description": "Marks obtained"
        },
        "maxMarks": {
          "type": "number",
          "description": "Maximum marks attainable"
        },
        "rank": {
          "type": "number",
          "description": "Calculated rank in batch"
        },
        "date": {
          "type": "string",
          "maxLength": 20,
          "description": "Test date YYYY-MM-DD"
        }
      },
      "required": ["studentId", "testTitle", "marks", "maxMarks", "date"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Admission enquiry or refer a friend submission",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Prospective student or parent name"
        },
        "phone": {
          "type": "string",
          "maxLength": 15,
          "description": "Contact phone number"
        },
        "referredBy": {
          "type": "string",
          "maxLength": 100,
          "description": "Name or roll number of student who referred"
        },
        "date": {
          "type": "string",
          "maxLength": 30,
          "description": "Enquiry date"
        },
        "status": {
          "type": "string",
          "maxLength": 30,
          "description": "Status e.g. new, contacted, enrolled"
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Follow-up notes"
        }
      },
      "required": ["name", "phone"]
    },
    "User": {
      "title": "User",
      "description": "User profile with access control role",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Email address"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "client", "viewer"],
          "description": "Role: owner (Akash Pandey), client (Coaching Sirs), viewer (Parents/Students)"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name"
        },
        "studentId": {
          "type": "string",
          "maxLength": 128,
          "description": "Associated student ID for parent/student viewers"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 50,
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Coaching branding and payment settings",
      "type": "object",
      "properties": {
        "posterImageUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Coaching banner/poster URL uploaded or set by owner"
        },
        "ownerUpiId": {
          "type": "string",
          "maxLength": 100,
          "description": "Owner UPI ID for fee collection"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Owner Name (Akash Pandey)"
        },
        "coachingName": {
          "type": "string",
          "maxLength": 100,
          "description": "Coaching Title (Parag Coaching)"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Official coaching helpline number"
        },
        "announcementText": {
          "type": "string",
          "maxLength": 500,
          "description": "Notice board message"
        }
      },
      "required": ["ownerUpiId", "coachingName"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student profiles and tuition details"
    },
    "/batches/{batchId}": {
      "schema": "Batch",
      "description": "Class batches and schedules"
    },
    "/fees/{feeId}": {
      "schema": "Fee",
      "description": "Fee records, payment states, and due dates"
    },
    "/attendance/{attendanceId}": {
      "schema": "Attendance",
      "description": "Daily batch attendance records"
    },
    "/tests/{testId}": {
      "schema": "Test",
      "description": "Weekly test marks and ranking"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Referrals and prospective admissions"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "System users and permission roles"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Coaching configuration and UPI payment gateway settings"
    }
  }
}
